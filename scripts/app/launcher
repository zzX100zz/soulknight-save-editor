#!/bin/bash
# Thin launcher: open a Terminal window that runs the bootstrap script, so the
# user always sees what is happening.  All the real work lives in bootstrap.sh
# inside the bundled tool, and the virtualenv lives outside the app bundle.
set -euo pipefail
HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")/../Resources/tool" && pwd)"
osascript <<APPLESCRIPT
tell application "Terminal"
    activate
    do script "cd '$HERE' && bash scripts/app/bootstrap.sh"
end tell
APPLESCRIPT
